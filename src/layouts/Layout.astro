---
import { SEO } from "astro-seo";
import "../styles/global.css";

export interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
}

const {
    title = "Opening Guessr - Anime Opening Quiz",
    description = "Play a free anime opening quiz. Listen to anime theme songs, guess the anime, and test your knowledge with Opening Guessr.",
    ogImage,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const ogImageUrl = ogImage ?? new URL("/opengraph.png", Astro.site).href;
---

<html lang="en">
    <head>
        <script is:inline>
            (function () {
                var theme =
                    localStorage.getItem("openingGuessr_theme") || "dracula";
                document.documentElement.setAttribute("data-theme", theme);
            })();
        </script>
        <meta charset="utf-8" />
        <meta
            name="google-site-verification"
            content="wo46kpVyrJS4omoHZlD6IlXXjN4UO5gfBpqYRbe2rhs"
        />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link
            rel="icon"
            type="image/png"
            href="/favicon-96x96.png?v=20260819"
            sizes="96x96"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260819" />
        <link rel="shortcut icon" href="/favicon.ico?v=20260819" />
        <link
            rel="apple-touch-icon"
            sizes="180x180"
            href="/apple-touch-icon.png?v=20260819"
        />
        <meta name="apple-mobile-web-app-title" content="OpGuessr" />
        <link rel="manifest" href="/site.webmanifest?v=20260819" />
        <SEO
            title={title}
            description={description}
            canonical={canonicalUrl}
            openGraph={{
                basic: {
                    title,
                    type: "website",
                    image: ogImageUrl,
                    url: canonicalUrl,
                },
                optional: {
                    description,
                    siteName: "Opening Guessr",
                    locale: "en_US",
                },
                image: {
                    alt: "Opening Guessr anime opening quiz",
                },
            }}
            twitter={{
                card: "summary_large_image",
                title,
                description,
                image: ogImageUrl,
                imageAlt: "Opening Guessr anime opening quiz",
            }}
            extend={{
                link: [{ rel: "sitemap", href: "/sitemap-index.xml" }],
            }}
        />
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                "@context": "https://schema.org",
                "@type": "WebApplication",
                name: "Opening Guessr",
                url: Astro.site?.href,
                description,
                applicationCategory: "Game",
                operatingSystem: "Any",
                offers: {
                    "@type": "Offer",
                    price: "0",
                    priceCurrency: "USD",
                },
            })}
        />
        <script
            defer
            src="/assets/helper.js"
            data-website-id="18246006-a86a-4aae-aa82-d2bf24d8e501"
            data-host-url="https://opguessr.com"
            data-astro-rerun></script>
        <script
            async
            src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4299046309223342"
            crossorigin="anonymous"
            defer></script>
    </head>
    <body class="relative min-h-screen bg-base-200 text-base-content">
        <div
            class="dropdown dropdown-end absolute top-4 right-4 z-50"
            :class="{ 'dropdown-open': open }"
            x-data="{ open: false }"
            @click.outside="open = false"
        >
            <button
                tabindex="0"
                role="button"
                class="btn btn-sm btn-ghost btn-square"
                aria-label="Theme selector"
                @click="open = !open"
            >
                <svg
                    xmlns="http://www.w3.org/2000/svg"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    stroke="currentColor"
                    class="size-5"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M9.53 16.122a3 3 0 0 0-5.78 1.128 2.25 2.25 0 0 1-2.4 2.245 4.5 4.5 0 0 0 8.4-2.245c0-.399-.078-.78-.22-1.128Zm0 0a15.998 15.998 0 0 0 3.388-1.62m-5.043-.025a15.994 15.994 0 0 1 1.622-3.395m3.42 3.42a15.995 15.995 0 0 0 4.764-4.648l3.876-5.814a1.151 1.151 0 0 0-1.597-1.597L14.146 6.32a15.996 15.996 0 0 0-4.649 4.763m3.42 3.42a6.776 6.776 0 0 0-3.42-3.42"
                    ></path>
                </svg>
            </button>
            <ul
                tabindex="-1"
                class="dropdown-content menu bg-base-100 rounded-box z-1 mt-2 w-44 p-2 shadow-xl border border-base-300 max-h-80 overflow-y-auto overflow-x-hidden flex-nowrap"
            >
                <template x-for="theme in $store.theme.themes" :key="theme">
                    <li
                        class="shrink-0"
                        :class="{ 'menu-active': $store.theme.current === theme }"
                    >
                        <button
                            class="justify-start text-left"
                            @click="$store.theme.set(theme); open = false"
                            x-text="theme"></button>
                    </li>
                </template>
            </ul>
        </div>

        <slot />

        <footer
            class="footer footer-horizontal footer-center bg-base-200 text-base-content rounded relative overflow-hidden p-10"
        >
            <div
                class="pointer-events-none select-none absolute inset-x-0 bottom-0 z-0 flex justify-center translate-y-5"
                aria-hidden="true"
            >
                <div
                    class="relative [-webkit-mask-image:linear-gradient(to_bottom,black_25%,transparent_80%)] [mask-image:linear-gradient(to_bottom,black_25%,transparent_80%)]"
                >
                    <span
                        class="font-bold text-shadow-primary text-shadow-sm text-shadow whitespace-nowrap leading-none text-[12vw] opacity-20 block"
                    >
                        Opening Guessr
                    </span>
                    <span
                        class="absolute inset-0 font-bold text-shadow-primary text-shadow-sm text-shadow whitespace-nowrap leading-none text-[12vw] opacity-20 block blur-3xl mask-[linear-gradient(to_bottom,transparent_45%,black_100%)] [-webkit-mask-image:linear-gradient(to_bottom,transparent_45%,black_100%)]"
                    >
                        Opening Guessr
                    </span>
                </div>
            </div>
            <nav class="grid grid-flow-col gap-4 relative z-10">
                <a href="/about" class="link link-hover">About</a>
                <a href="/faq" class="link link-hover">FAQ</a>
                <a
                    href="mailto:bassmmm@proton.me"
                    target="_blank"
                    class="link link-hover">Say Hi!</a
                >
                <a
                    href="https://www.buymeacoffee.com/bassmm"
                    target="_blank"
                    class="link link-hover">Support Me :)</a
                >
            </nav>
            <nav class="relative z-10">
                <div class="grid grid-flow-col gap-4">
                    <a
                        href="https://x.com/bassmmdotdev"
                        target="_blank"
                        class="hover:brightness-200"
                    >
                        <i class="ph ph-x-logo text-2xl"></i>
                    </a>
                    <a
                        href="https://discord.gg/ut7qEW9aXq"
                        target="_blank"
                        class="hover:brightness-200"
                    >
                        <i class="ph ph-discord-logo text-2xl"></i>
                    </a>
                    <a
                        href="https://www.buymeacoffee.com/bassmm"
                        target="_blank"
                        class="hover:brightness-200"
                    >
                        <i class="ph ph-coffee text-2xl"></i>
                    </a>
                </div>
            </nav>
            <aside class="relative z-10">
                <p>
                    ©
                    <a href="https://bassmm.dev"> bassmm.dev</a>
                </p>
            </aside>
        </footer>
    </body>
</html>

<script>
    document.addEventListener("alpine:init", () => {
        Alpine.store("theme", {
            themes: [
                "light",
                "dark",
                "cupcake",
                "bumblebee",
                "emerald",
                "synthwave",
                "retro",
                "cyberpunk",
                "valentine",
                "halloween",
                "garden",
                "forest",
                "lofi",
                "wireframe",
                "black",
                "dracula",
                "cmyk",
                "autumn",
                "lemonade",
                "night",
                "coffee",
                "dim",
                "nord",
                "sunset",
            ],
            current:
                document.documentElement.getAttribute("data-theme") ||
                localStorage.getItem("openingGuessr_theme") ||
                "dracula",
            set(theme) {
                this.current = theme;
                localStorage.setItem("openingGuessr_theme", theme);
            },
        });

        Alpine.effect(() => {
            const theme = Alpine.store("theme").current;
            document.documentElement.setAttribute("data-theme", theme);
        });
    });
</script>
