---
import Layout from "../../layouts/Layout.astro";
import { loadOpenings } from "../../data/load-openings.js";
import { readCache, writeEntry } from "../../scripts/cover-cache.js";

export async function getStaticPaths() {
    const openings = await loadOpenings();
    return openings.map((anime) => ({
        params: { slug: anime.slug },
        props: { anime },
    }));
}

const { anime } = Astro.props;
const displayName = anime.name_english || anime.name;
const yearLabel = anime.year ? String(anime.year) : null;
const title = `${displayName} | Opening Guessr`;
const description = `Guess ${displayName}${yearLabel ? ` (${yearLabel})` : ""} from its opening theme${anime.song?.title ? ` — ${anime.song.title} by ${anime.song.artist || "unknown artist"}` : ""}. Test your anime knowledge with Opening Guessr.`;
const ogImage = new URL(`/open-graph/anime/${anime.slug}.png`, Astro.site).href;
const cachedCover = readCache()[anime.mal_id] ?? null;

const starSteps = [];
for (let i = 1; i <= 10; i++) {
    const value = i / 2;
    starSteps.push({
        value,
        half: value % 1 !== 0 ? "mask-half-1" : "mask-half-2",
    });
}
const roundedHalf =
    anime.score != null ? Math.round((anime.score / 2) * 2) / 2 : null;
---

<Layout title={title} description={description} ogImage={ogImage}>
    <div class="min-h-screen bg-base-200">
        <div class="navbar bg-base-100 shadow-sm px-4 sm:px-6 py-3 min-h-16">
            <div class="navbar-start">
                <a href="/anime/" class="btn btn-ghost btn-sm">
                    <i class="ph ph-arrow-circle-left text-3xl"></i>
                    <span class="hidden sm:inline">All anime</span>
                </a>
            </div>
            <div class="navbar-center">
                <a
                    href="/"
                    class="text-3xl sm:text-4xl font-bold text-shadow-primary text-shadow-xs"
                    >Opening Guessr</a
                >
            </div>
            <div class="navbar-end"></div>
        </div>

        <main class="max-w-3xl mx-auto px-4 py-8 sm:py-12">
            <div class="card bg-base-100 shadow-xl">
                <div class="card-body gap-6">
                    <div class="flex flex-col sm:flex-row gap-6">
                        <div
                            class="relative shrink-0 mx-auto sm:mx-0 w-48 h-64"
                            x-data="{ loaded: false }"
                            x-init="loaded = document.getElementById('anime-cover').complete && document.getElementById('anime-cover').naturalWidth > 0"
                        >
                            <div
                                class="skeleton absolute inset-0 rounded-box"
                                x-show="!loaded"
                            >
                            </div>
                            <img
                                id="anime-cover"
                                data-mal-id={anime.mal_id}
                                src={cachedCover ?? undefined}
                                alt={displayName}
                                @load="loaded = true"
                                class="absolute inset-0 h-full w-full object-cover rounded-box shadow-lg transition-opacity"
                                :class="loaded ? 'opacity-100' : 'opacity-0'"
                            />
                        </div>
                        <div class="flex-1">
                            {
                                yearLabel ? (
                                    <p class="py-1 text-lg text-base-content/60">
                                        {yearLabel}
                                    </p>
                                ) : null
                            }

                            <h1 class="text-3xl font-bold">{displayName}</h1>
                            {
                                anime.name_english &&
                                anime.name_english !== anime.name ? (
                                    <p class="text-lg opacity-75">
                                        {anime.name}
                                    </p>
                                ) : null
                            }
                            <div class="mt-3 flex flex-wrap gap-2">
                                <a
                                    href={`https://myanimelist.net/anime/${anime.mal_id}`}
                                    target="_blank"
                                    rel="noopener"
                                    class="badge badge-sm bg-[#2E51A2] link link-hover gap-2 border-transparent text-white"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="h-3.5 w-3.5"
                                        fill="currentColor"
                                        aria-hidden="true"
                                        ><path
                                            d="M4 20 V5 h5 l3 5 3-5 h5 v15 h-4 v-8 l-4 6-4-6 v8 Z"
                                        ></path></svg
                                    >
                                    <span class="">MAL</span>
                                </a>
                                <a
                                    href={`https://anilist.co/anime/${anime.mal_id}`}
                                    target="_blank"
                                    rel="noopener"
                                    class="badge badge-sm bg-[#02A9FF] link link-hover gap-2 border-transparent text-white"
                                >
                                    <svg
                                        viewBox="0 0 24 24"
                                        class="h-3.5 w-3.5"
                                        fill="currentColor"
                                        aria-hidden="true"
                                        ><path
                                            d="M12 3 3 20h4.5l4.5-9 4.5 9H21L12 3Z"
                                        ></path></svg
                                    >
                                    <span class="link link-hover">AniList</span>
                                </a>
                                <a
                                    href={`https://animethemes.moe/anime/${anime.slug}`}
                                    target="_blank"
                                    rel="noopener"
                                    class="badge badge-sm bg-[#f5f2fa] link link-hover gap-2 border-transparent text-[#1c1823]"
                                    ><svg
                                        fill="currentColor"
                                        viewBox="0 0 160 86.6"
                                        class="h-3.5 w-3.5"
                                        ><polygon
                                            points="56.25 32.48 56.25 75.78 75 86.6 75 0 0 43.3 18.75 54.13 56.25 32.48"
                                        ></polygon><polygon
                                            points="103.75 32.48 141.25 54.13 160 43.3 85 0 85 86.6 103.75 75.78 103.75 32.48"
                                        ></polygon></svg
                                    >
                                    <span class="link link-hover"
                                        >AnimeThemes</span
                                    >
                                </a>
                            </div>

                            <div
                                class="mt-6 flex flex-wrap items-center gap-2 text-sm"
                            >
                                {
                                    anime.score != null ? (
                                        <div class="badge badge-soft badge-warning badge-xl">
                                            <div
                                                class="rating rating-half rating-sm"
                                                role="img"
                                                aria-label={`Rating ${anime.score} out of 10`}
                                            >
                                                {starSteps.map((step) => (
                                                    <input
                                                        type="radio"
                                                        name={`rating-${anime.mal_id}`}
                                                        class={`mask mask-star-2 ${step.half} bg-orange-400`}
                                                        disabled
                                                        checked={
                                                            step.value ===
                                                            roundedHalf
                                                        }
                                                        aria-label={`${step.value} star`}
                                                    />
                                                ))}
                                            </div>
                                            <span class="opacity-75">
                                                {anime.score}
                                            </span>
                                        </div>
                                    ) : null
                                }
                                {
                                    anime.rank != null ? (
                                        <span class="badge badge-xl badge-soft badge-error">
                                            <i class="ph ph-heart" />
                                            No. {anime.rank} Most Popular
                                        </span>
                                    ) : null
                                }

                                {
                                    anime.genres && anime.genres.length > 0 ? (
                                        <div class="flex flex-wrap gap-2 mt-6">
                                            {anime.genres.map((g) => (
                                                <span class="badge badge-neutral">
                                                    {g}
                                                </span>
                                            ))}
                                        </div>
                                    ) : null
                                }
                            </div>
                        </div>
                    </div>

                    <div class="flex flex-col gap-1">
                        {
                            anime.song?.title ? (
                                <div class="flex flex-col">
                                    {anime.song.artist ? (
                                        <span class="opacity-75 text-xs ml-7">
                                            {anime.song.artist}
                                        </span>
                                    ) : null}
                                    <div class="flex flex-row gap-1">
                                        <i class="text-2xl align-middle ph ph-cassette-tape" />{" "}
                                        <span class="font-semibold">
                                            {anime.song.title}
                                        </span>
                                    </div>
                                </div>
                            ) : null
                        }

                        {
                            anime.video ? (
                                <div class="w-full border rounded-box overflow-hidden">
                                    <video
                                        id="anime-video"
                                        src={anime.video}
                                        poster={cachedCover ?? undefined}
                                        preload="metadata"
                                        controls
                                        class="w-full"
                                    />
                                </div>
                            ) : null
                        }
                    </div>

                    <div class="flex flex-wrap gap-6">
                        <a href="/" class="btn btn-primary">Play the game</a>
                    </div>
                </div>
            </div>
        </main>
    </div>

    <script>
        import { readCache, writeEntry } from "../../scripts/cover-cache.js";
        import { fetchCover } from "../../scripts/cover-fetch.js";
        import { initPlyr } from "../../scripts/plyr.js";
        import "plyr/dist/plyr.css";

        const videoEl = document.getElementById("anime-video");
        if (videoEl) {
            initPlyr(videoEl, "video", { clip: false });
        }

        const img = document.getElementById("anime-cover");
        const malId = parseInt(img.getAttribute("data-mal-id"), 10);
        const cached = readCache()[malId];
        if (cached && !img.getAttribute("src")) img.src = cached;
        if (!cached) {
            fetchCover(malId)
                .then((url) => {
                    if (url) {
                        img.src = url;
                        writeEntry(malId, url);
                    }
                })
                .catch(() => {});
        }
    </script>
</Layout>
