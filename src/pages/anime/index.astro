---
import Layout from "../../layouts/Layout.astro";
import { loadOpenings } from "../../data/load-openings.js";

const openings = await loadOpenings();
const title = "Anime Directory - Browse Anime Openings | Opening Guessr";
const description =
    "Browse every anime opening in Opening Guessr. Search by title, filter by genre, and sort by popularity, score, or year.";
---

<Layout
    title={title}
    description={description}
    ogImage={new URL("/open-graph/anime.png", Astro.site).href}
>
    <div
        x-data={`directory(${JSON.stringify(openings)})`}
        class="min-h-screen bg-base-200"
    >
        <div class="navbar bg-base-100 shadow-sm px-4 sm:px-6 py-3 min-h-16">
            <div class="navbar-start">
                <a href="/" class="btn btn-ghost btn-sm">← Back to game</a>
            </div>
            <div class="navbar-center">
                <span class="text-4xl font-bold text-shadow-primary text-shadow-xs">Opening Guessr</span>
            </div>
            <div class="navbar-end"></div>
        </div>

        <main class="max-w-6xl mx-auto px-8 py-8">
            <h1 class="text-4xl font-bold">Anime Directory</h1>
            <p class="py-6 text-lg opacity-75">
                Every anime opening in Opening Guessr. Search by title, filter
                by genre, or sort by popularity, score, and year.
            </p>

            <div class="relative">
                <div class="flex flex-row flex-wrap gap-4 items-start">
                    <fieldset class="fieldset flex-1">
                        <legend class="text-lg mb-1">Search</legend>
                        <label class="input">
                            <i class="ph ph-magnifying-glass"></i>
                            <input
                                type="search"
                                x-model="query"
                                placeholder="Search by title..."
                                class="input input-bordered w-full"
                            />
                        </label>
                        <p
                            class="label text-sm opacity-75"
                            x-cloak
                            x-text="filtered.length + ' anime'"></p>
                    </fieldset>
                    <fieldset class="fieldset">
                        <legend class="text-lg mb-1">Sort</legend>
                        <select
                            x-model="sortBy"
                            class="select select-bordered select-md mr-2"
                        >
                            <option value="rank">Most popular</option>
                            <option value="score">Highest score</option>
                            <option value="year">Newest</option>
                        </select>
                    </fieldset>
                    <fieldset class="fieldset">
                        <legend class="text-lg mb-1">Genre</legend>
                        <button
                            type="button"
                            class="select select-bordered select-md mr-2"
                            @click="dropdownOpen = !dropdownOpen"
                        >
                            <span>Filter by Genre(s)</span>
                            <span
                                class="badge badge-primary"
                                x-cloak
                                x-text="selectedGenres.length"
                                x-show="selectedGenres.length > 0"
                            ></span>
                        </button>
                    </fieldset>
                </div>

                <div
                    class="absolute left-0 right-0 top-full mt-2 bg-base-100 rounded-box shadow-sm p-4 z-50"
                    x-cloak
                    x-show="dropdownOpen"
                    @click.outside="dropdownOpen = false"
                >
                    <input
                        type="search"
                        x-model="genreQuery"
                        placeholder="Search genres..."
                        class="input input-bordered input-sm w-full mb-2"
                    />
                    <form class="filter">
                        <template x-for="g in filteredGenres" :key="g.name">
                            <input
                                class="btn btn-sm"
                                type="checkbox"
                                name="genre"
                                :value="g.name"
                                :checked="selectedGenres.includes(g.name)"
                                @change="toggleGenre(g.name)"
                                :aria-label="g.name + ' (' + g.count + ')'"
                            />
                        </template>
                    </form>
                </div>
            </div>

            <form
                class="filter mt-4"
                x-cloak
                x-show="selectedGenres.length > 0 && !dropdownOpen"
            >
                <template x-for="g in selectedGenres" :key="g">
                    <input
                        class="btn btn-xs"
                        type="checkbox"
                        name="activeGenres"
                        :value="g"
                        :checked="true"
                        @change="toggleGenre(g)"
                        :aria-label="g"
                    />
                </template>
                <input
                    class="btn btn-xs btn-square"
                    type="reset"
                    value="×"
                    @click="selectedGenres = []"
                />
            </form>

            <ul
                class="grid grid-cols-[repeat(auto-fill,minmax(160px,1fr))] gap-10 mt-6"
                x-cloak
            >
                {openings.map((a) => (
                    <li x-show={`!narrowed || pageVisible[${a.mal_id}]`}>
                        <a href={`/anime/${a.slug}/`} class="relative block">
                            <div class="relative aspect-2/3 overflow-hidden rounded-box bg-base-300">
                                <img
                                    :src={`covers[${a.mal_id}]`}
                                    :alt={a.name_english || a.name}
                                    :class={`coversLoaded[${a.mal_id}] ? 'opacity-100' : 'opacity-0'`}
                                    @load={`coversLoaded[${a.mal_id}] = true`}
                                    class="absolute inset-0 h-full w-full object-cover transition-opacity"
                                    loading="lazy"
                                />
                            </div>
                            <h2 class="mt-2 px-1 text-sm font-semibold leading-tight line-clamp-2">
                                {a.name_english || a.name}
                            </h2>
                            <div class="mt-1 flex flex-wrap gap-1.5 px-1 text-xs opacity-75">
                                {a.score != null && <span>{a.score}</span>}
                                {a.rank != null && <span>#{a.rank}</span>}
                                {a.year && <span>{a.year}</span>}
                            </div>
                            <div
                                class="absolute inset-0 flex flex-col rounded-box"
                                x-show={`!coversLoaded[${a.mal_id}]`}
                            >
                                <div class="skeleton aspect-2/3 w-full"></div>
                            </div>
                        </a>
                    </li>
                ))}
            </ul>

            <div
                x-cloak
                x-show="totalPages > 1"
                class="flex items-center justify-center gap-3 mt-8"
            >
                <button
                    class="btn btn-outline btn-sm"
                    :disabled="page <= 1"
                    @click="prevPage()"
                >
                    Previous
                </button>
                <span
                    class="text-sm opacity-75"
                    x-text="'Page ' + page + ' of ' + totalPages"></span>
                <button
                    class="btn btn-outline btn-sm"
                    :disabled="page >= totalPages"
                    @click="nextPage()"
                >
                    Next
                </button>
            </div>
        </main>
    </div>
</Layout>

<script>
    import "../../scripts/directory.js";
</script>
