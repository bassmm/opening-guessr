---
import Layout from "../layouts/Layout.astro";
import MenuScreen from "../components/MenuScreen.astro";
import GameNavbar from "../components/GameNavbar.astro";
import ModeToggle from "../components/ModeToggle.astro";
import MediaPlayer from "../components/MediaPlayer.astro";
import SearchInput from "../components/SearchInput.astro";
import AnswerCard from "../components/AnswerCard.astro";
import ResultScreen from "../components/ResultScreen.astro";
import "plyr/dist/plyr.css";
---

<Layout>
    <div x-data="game()" class="min-h-screen flex flex-col">
        <template x-if="screen === 'menu'">
            <MenuScreen />
        </template>

        <template x-if="screen === 'playing'">
            <div class="min-h-screen bg-base-200 flex flex-col">
                <GameNavbar />

                <div
                    class="flex-1 flex flex-col items-center px-4 py-6 sm:p-8 gap-6 sm:gap-8 max-w-3xl mx-auto w-full"
                >
                    <MediaPlayer />
                    <ModeToggle />
                    <div x-show="!answered" class="w-full">
                        <SearchInput />
                    </div>

                    <AnswerCard />
                </div>
            </div>
        </template>

        <template x-if="screen === 'result'">
            <ResultScreen />
        </template>
    </div>
</Layout>

<script>
    import "../scripts/game.js";
</script>
