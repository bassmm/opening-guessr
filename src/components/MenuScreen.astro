<div>
    <div class="hero min-h-screen bg-base-200 pt-16">
        <div class="hero-content text-center">
            <div class="max-w-2xl w-full min-w-0">
                <div class="mb-12">
                    <h1
                        class="text-7xl font-bold text-shadow-primary text-shadow-sm text-shadow"
                    >
                        Opening Guessr
                    </h1>
                    <p class="py-6 text-2xl">
                        Guess the anime from its opening theme!
                    </p>
                </div>
                <div class="flex flex-col gap-6">
                    <!-- List Mode Toggle -->
                    <div role="tablist" class="tabs tabs-box input w-full">
                        <button
                            role="tab"
                            class="tab flex-1"
                            :class="{ 'tab-active': listMode === 'difficulty' }"
                            @click="setListMode('difficulty')"
                        >
                            Difficulty
                        </button>
                        <button
                            role="tab"
                            class="tab flex-1"
                            :class="{ 'tab-active': listMode === 'popular' }"
                            @click="setListMode('popular')"
                        >
                            Popularity
                        </button>
                        <button
                            role="tab"
                            class="tab flex-1"
                            :class="{ 'tab-active': listMode === 'mal' }"
                            @click="setListMode('mal')"
                        >
                            My MAL List
                        </button>
                    </div>

                    <!-- Difficulty Selector -->
                    <div class="join w-full border border-neutral/10 rounded-field p-0.75" x-show="listMode === 'difficulty'">
                        <input
                            class="join-item btn btn-md btn-soft flex-1"
                            type="radio"
                            name="difficulty"
                            aria-label="Easy"
                            value="easy"
                            x-model="difficultyLevel"
                        />
                        <input
                            class="join-item btn btn-md btn-soft flex-1"
                            type="radio"
                            name="difficulty"
                            aria-label="Medium"
                            value="medium"
                            x-model="difficultyLevel"
                        />
                        <input
                            class="join-item btn btn-md btn-soft flex-1"
                            type="radio"
                            name="difficulty"
                            aria-label="Hard"
                            value="hard"
                            x-model="difficultyLevel"
                        />
                    </div>

                    <select
                        x-show="listMode === 'popular'"
                        class="select select-bordered select-lg w-full text-lg"
                        x-model.number="difficulty"
                    >
                        <option :value="50">Top 50</option>
                        <option :value="100">Top 100</option>
                        <option :value="500">Top 500</option>
                        <option :value="1000">Top 1000</option>
                        <option :value="2500">Top 2500</option>
                    </select>

                    <!-- MAL List Loader -->
                    <div
                        x-show="listMode === 'mal'"
                        class="flex flex-col gap-3"
                    >
                        <div class="join w-full">
                            <input
                                type="text"
                                placeholder="MyAnimeList username"
                                class="input input-bordered input-lg join-item flex-1 text-lg"
                                x-model="malUsername"
                                @keydown.enter="loadMalList()"
                                :disabled="malLoading"
                            />
                            <button
                                class="btn btn-lg join-item"
                                @click="loadMalList()"
                                :disabled="malLoading || !malUsername.trim()"
                            >
                                <span x-show="!malLoading">Load</span>
                                <span
                                    x-show="malLoading"
                                    class="loading loading-spinner"></span>
                            </button>
                        </div>
                        <p
                            x-show="malProgress"
                            class="text-sm opacity-75"
                            x-text="malProgress"
                        >
                        </p>
                        <p
                            x-show="malError"
                            class="text-error text-sm"
                            x-text="malError"
                        >
                        </p>
                        <div
                            x-show="malPool.length > 0 && !malLoading"
                            class="text-sm opacity-75 flex items-center justify-between px-1"
                        >
                            <span>
                                Openings found:
                                <span class="font-bold" x-text="malPool.length"
                                ></span>
                            </span>
                            <button
                                class="btn btn-xs btn-ghost"
                                @click="loadMalList(true)"
                                title="Re-fetch list and ignore cache"
                            >
                                Reload list
                            </button>
                        </div>
                    </div>

                    <!-- Optional Genre Filter Multi-Select Collapse -->
                    <details
                        class="collapse collapse-arrow border border-base-content/20 bg-base-100 rounded-box text-left w-full max-w-full overflow-hidden"
                    >
                        <summary class="collapse-title">
                            Filter by Genre (Optional)
                            <template x-if="selectedGenres.length > 0">
                                <span
                                    class="badge badge-primary ml-2"
                                    x-text="selectedGenres.length"></span>
                            </template>
                        </summary>
                        <div
                            class="collapse-content flex flex-wrap gap-2 pt-2 justify-start max-h-60 overflow-y-auto overflow-x-hidden"
                        >
                            <template x-for="g in activeGenres" :key="g.name">
                                <button
                                    type="button"
                                    class="btn btn-xs sm:btn-sm"
                                    :class="selectedGenres.includes(g.name) ? 'btn-primary' : 'btn-outline'"
                                    @click="toggleGenre(g.name)"
                                >
                                    <span x-text="g.name"></span>
                                    <span
                                        class="opacity-60 text-xs"
                                        x-text="'(' + g.count + ')'"></span>
                                </button>
                            </template>
                        </div>
                    </details>

                    <!-- Live Pool Status Indicator -->
                    <div class="text-sm opacity-75 flex justify-between px-1">
                        <span>Matching anime in pool:</span>
                        <span class="font-bold" x-text="filteredPoolCount"
                        ></span>
                    </div>

                    <button
                        class="btn btn-primary btn-block btn-lg text-lg"
                        @click="startGame()"
                        :disabled="loading || malLoading || filteredPoolCount < totalRounds"
                    >
                        <span x-show="!loading">Start Game</span>
                        <span x-show="loading" class="loading loading-spinner"
                        ></span>
                    </button>

                    <a href="/anime/" class="btn btn-soft btn-primary"
                        >Browse Anime Directory</a
                    >

                    <p
                        x-show="filteredPoolCount < totalRounds && (listMode === 'mal' ? malPool.length > 0 : dataset.length > 0)"
                        class="text-error text-sm text-center"
                    >
                        <span x-show="listMode === 'popular'">
                            Not enough anime match your criteria (need at least
                            5). Try broadening your rank or genre filters.
                        </span>
                        <span x-show="listMode === 'difficulty'">
                            Not enough anime match your criteria (need at least
                            5). Try a different difficulty or removing genre
                            filters.
                        </span>
                        <span x-show="listMode === 'mal'">
                            Not enough anime match your criteria (need at least
                            5). Try removing genre filters.
                        </span>
                    </p>
                </div>
                <div class="mt-12 text-lg opacity-60">
                    <p
                        x-text="'5 rounds · Audio mode: ' + pointsAudio + ' pts · Video mode: ' + pointsVideo + ' pts'"
                    >
                    </p>
                    <div class="flex gap-4 justify-center mt-4">
                        <kbd class="kbd kbd-lg">Enter</kbd>
                        <span class="text-sm">Submit answer</span>
                        <kbd class="kbd kbd-lg">Esc</kbd>
                        <span class="text-sm">Close suggestions</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
