<div class="text-center text-sm opacity-50 w-full" x-show="!answered">
    <span
        x-text="mode === 'audio' ? 'Listen to the opening (' + (videoUnlocked ? '500' : '1000') + ' pts)' : 'Watch the blurred opening (500 pts)'"
    ></span>
</div>

<div class="w-full">
    <audio
        x-show="mode === 'audio'"
        :src="current?.audio"
        x-ref="audioPlayer"
        controls
        class="w-full"
        x-init="initPlyr('audio')"></audio>
    <div x-show="mode === 'video'" class="relative">
        <video
            :src="current?.video"
            x-ref="videoPlayer"
            preload="metadata"
            controls
            playsinline
            disablepictureinpicture
            class="w-full"
            :class="{ 'blur-[9px]': !answered }"
            @seeking="if ($el.currentTime < 25 || $el.currentTime > 65) $el.currentTime = Math.min(Math.max($el.currentTime, 25), 65)"
            @timeupdate="if ($el.currentTime >= 65) $el.pause()"
            @play="if ($el.currentTime >= 63) $el.currentTime = 25"></video>
    </div>
    <p class="text-base opacity-50 text-center mt-2" x-show="mode === 'video'">
        Video starts at 25s and stops at 65s
    </p>
    <template x-if="playerError">
        <div class="alert alert-error shadow-lg mt-2" role="alert">
            <div>
                <span>Media failed to load. Check your connection and try again.</span>
            </div>
            <button class="btn btn-sm btn-primary" @click="retryMedia()">Retry</button>
        </div>
    </template>
</div>
