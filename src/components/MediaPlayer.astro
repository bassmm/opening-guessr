<div class="text-center text-sm opacity-50 w-full" x-show="!answered">
    <span
        x-text="mode === 'audio' ? 'Listen to the opening (' + (videoUnlocked ? pointsVideo : pointsAudio) + ' pts)' : 'Watch the blurred opening (' + pointsVideo + ' pts)'"
    ></span>
</div>

<div class="w-full">
    <audio
        x-show="mode === 'audio'"
        :src="current?.audio"
        x-ref="audioPlayer"
        controls
        class="w-full"
        x-init="initPlyr('audio')"></audio>
    <div x-show="mode === 'video'" class="relative">
        <video
            :src="current?.video"
            x-ref="videoPlayer"
            preload="metadata"
            controls
            playsinline
            disablepictureinpicture
            class="w-full"
            :class="{ 'blur-[9px]': !answered }"
            x-init="initPlyr('video')"
            @seeking="clampSeek($el)"
            @timeupdate="stopAtEnd($el)"
            @play="restartIfNearEnd($el)"></video>
    </div>
    <p class="text-base opacity-50 text-center mt-2" x-show="mode === 'video'">
        Video starts at 25s and stops at 65s
    </p>
    <div class="flex justify-center mt-3" x-show="answered">
        <button
            class="btn btn-outline btn-sm"
            type="button"
            @click="openFullOpening()"
        >
            <i class="ph ph-play-circle text-lg"></i>
            Watch full opening
        </button>
    </div>
</div>

<dialog class="modal bg-none" x-ref="fullModal" @close="closeFullOpening()">
    <div class="modal-box max-w-4xl bg-none">
        <form method="dialog">
            <button
                class="btn btn-md btn-circle btn-soft btn-primary absolute right-2 top-2"
                >✕</button
            >
        </form>
        <video
            x-ref="fullVideo"
            :src="current?.video"
            controls
            playsinline
            preload="none"
            class="w-full rounded-box"></video>
    </div>
    <form method="dialog" class="modal-backdrop bg-none">
        <button>close</button>
    </form>
</dialog>
