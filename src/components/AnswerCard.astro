<div x-show="answered" class="card bg-base-100 shadow-xl w-full">
    <div class="card-body items-center text-center gap-4 px-4 sm:px-6">
        <div
            class="text-3xl sm:text-4xl font-bold"
            :class="isCorrect ? 'text-success' : 'text-error'"
        >
            <span x-text="isCorrect ? 'Correct!' : 'Wrong!'"></span>
        </div>
        <div class="flex gap-4 sm:gap-6 items-start w-full max-w-lg">
            <div
                x-show="coverLoading"
                class="skeleton w-24 sm:w-36 shrink-0 rounded-box aspect-2/3"
            >
            </div>
            <img
                x-show="coverUrl"
                :src="coverUrl"
                :alt="correctTitle"
                class="w-24 sm:w-36 aspect-2/3 shrink-0 rounded-box shadow-md"
            />
            <div class="flex flex-col gap-2 min-w-0 text-left">
                <div>
                    <p class="text-sm uppercase opacity-80">The answer is:</p>
                    <div class="flex flex-col items-baseline gap-x-2">
                        <a
                            :href="animeLink(current)"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center gap-1 text-lg sm:text-2xl font-bold hover:underline"
                        ><span x-text="correctTitle"></span><i class="ph ph-arrow-square-out text-base sm:text-lg opacity-60"></i></a>
                        <span
                            x-show="current?.name_english"
                            class="text-md sm:text-xl opacity-60"
                            x-text="current.name_english"></span>
                    </div>
                    <p
                        x-show="current?.song?.title"
                        class="text-xs sm:text-sm opacity-50 mt-2 mb-3"
                    >
                        <span x-text="'♪ ' + current.song.title"></span>
                        <span
                            x-show="current?.song?.artist"
                            x-text="' — ' + current.song.artist + ' ♪'"></span>
                    </p>
                </div>
                <p
                    class="text-base opacity-70"
                    x-text="(isCorrect ? (videoUnlocked ? '+500' : '+1000') : '+0') + ' points'"
                >
                </p>
                <div class="flex items-center gap-2 mt-1">
                    <template x-for="(r, i) in results" :key="i">
                        <div
                            class="w-4 h-4 rounded-full bg-current"
                            :class="r.correct ? 'text-success' : 'text-error'"
                        ></div>
                    </template>
                    <template
                        x-for="i in (totalRounds - results.length)"
                        :key="'empty-' + i"
                    >
                        <div class="w-4 h-4 rounded-full border-2 border-base-content/40"></div>
                    </template>
                </div>
            </div>
        </div>
        <button class="btn btn-primary btn-block btn-lg" @click="nextRound()">
            <span x-text="round >= totalRounds ? 'See Results' : 'Next Round'"
            ></span>
        </button>
    </div>
</div>
