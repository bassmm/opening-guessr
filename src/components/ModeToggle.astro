<div class="join flex w-full sm:w-auto" x-show="!answered">
    <button
        class="join-item btn btn-lg flex-1 sm:flex-none"
        :class="{ 'btn-active': mode === 'audio' }"
        @click="mode = 'audio'"
        :disabled="!current?.audio"
    >
        <span class="hidden sm:inline">Audio only </span><span class="sm:hidden"
            >Audio
        </span><span
            class="text-sm opacity-60"
            x-text="videoUnlocked ? '500' : '1000'"></span><span
            class="text-xs opacity-70">pts</span
        >
    </button>
    <button
        class="join-item btn btn-lg flex-1 sm:flex-none"
        :class="{ 'btn-active': mode === 'video' }"
        @click="switchToVideo()"
        :disabled="!current?.video"
    >
        <i
            x-bind:class="videoUnlocked ? 'ph ph-lock-open text-primary' : 'ph ph-lock text-primary'"
        ></i>
        <span
            class="hidden sm:inline"
            x-text="videoUnlocked ? 'Video Clue Unlocked' : 'Unlock Video Clue'"
        ></span>
        <span class="sm:hidden" x-text="videoUnlocked ? 'Video' : 'Video'"
        ></span>
        <span
            class="text-sm opacity-60"
            x-text="videoUnlocked ? '500' : '-500'"
        >
        </span><span class="text-xs opacity-70">pts</span>
    </button>
</div>
