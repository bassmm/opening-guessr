<div class="hero min-h-screen bg-base-200">
  <div class="hero-content text-center">
    <div class="max-w-md w-full">
      <h1 class="text-4xl font-bold">Game Over!</h1>

      <div class="stats stats-vertical shadow mt-8 w-full">
        <div class="stat">
          <div class="stat-title">Score</div>
          <div class="stat-value text-primary" x-text="score + ' / 5000'"></div>
        </div>
        <div class="stat">
          <div class="stat-title">Correct</div>
          <div class="stat-value" x-text="results.filter(r => r.correct).length + ' / ' + totalRounds"></div>
          <div class="stat-desc" x-text="(results.filter(r => r.correct).length / totalRounds * 100).toFixed(0) + '% accuracy'"></div>
        </div>
        <div class="stat">
          <div class="stat-title">High Score</div>
          <div class="stat-value text-secondary" x-text="highScore"></div>
          <div class="stat-desc" x-show="score >= highScore && score > 0">New record!</div>
        </div>
      </div>

      <div class="flex gap-2 mt-8 justify-center">
        <button class="btn btn-primary" @click="startGame()">Play Again</button>
        <button class="btn btn-outline" @click="backToMenu()">Menu</button>
      </div>
    </div>
  </div>
</div>
